# timui.h chat — autoplay demo for screen recordings.
#   run:  ./build/chat --demo examples/chat.demo   (or: make run-chat-demo)
# Actions:  wait <ms> | msg <text> | say <text> | img <path>
#           scroll <n> | open | close | quit
# '#'/blank lines are ignored.

wait 400
msg alice: hey! did the new chat land? 👋
wait 150
msg bob: yep — images, markdown, scrollback, the lot. try `make run-chat`
wait 180
msg yuki: こんにちは 🌏 日本語も完璧です！
wait 130
msg jihoon: 안녕하세요! 한국어도 잘 나오네요 👍
wait 130
msg wei: 你好！中文完全没问题 🎉
wait 130
msg kaming: 早晨！廣東話都得 😎
wait 130
msg dmitri: Привет! русский тоже работает 👍
wait 130
msg elena: Γειά σου! και ελληνικά ✨
wait 130
msg avi: שלום! עברית עובדת מצוין 👀
wait 130
msg omar: مرحبا! والعربية أيضا 🎉
wait 350
say every script, LTR *and* RTL — it just works :sparkles:
wait 300
msg jihoon: 오 대박 👀
wait 250
msg bob: c99 never looked this *sexy* on a terminal :eyes:
wait 300
say and markdown too — *bold*, _italic_, `code` :fire:
wait 400
msg maya: fresh from the design team — new logo! :sparkles:
wait 250
msg maya: ![t_ logo](examples/assets/logo.png)
wait 600
open
wait 350
close
wait 300
msg kaming: 個 logo 好正 😎
wait 300
say :heart: love it — and click any image for fullscreen
wait 400
msg alice: graphics? someone call the kitty! :rocket:
wait 300
msg bob: works great with ghosts... eh ..^Wtty! :joy:
wait 400
msg maya: works with remote images too ![gh](https://github.com/fluidicon.png)
wait 1800
msg alice: ...and link previews 👀 https://github.com
wait 2400
say let me scroll up to re-read
wait 500
scroll 11
wait 900
msg dmitri: а мы всё пишем сюда 👋
wait 600
msg wei: 计数器还在涨! :tada:
wait 600
msg elena: κι άλλο μήνυμα ✨
wait 600
msg omar: ورسالة أخرى 👀
wait 600
msg avi: ועוד אחת 🎉
wait 1000
scroll -40
wait 900
say caught up! and :name: shortcodes work too :thumbsup: :tada:
wait 500
say c99, single header only! :sparkles:
wait 1000
say thanks all — bye! :wave:
wait 300
msg alice: bye! 👋
wait 200
msg kaming: 拜拜! 😎
wait 200
msg dmitri: пока! 👋
wait 200
msg omar: مع السلامة 🎉
wait 200
msg jihoon: 안녕! 👋
wait 200
msg yuki: またね ✨
wait 1500
quit
